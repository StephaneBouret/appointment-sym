<button type="button" class="toggle-password-button" aria-controls="{{ input_id }}" hidden
        data-toggle-password-target="button" data-action="toggle-password#toggle">
    <span data-toggle-password-target="showLabel"><i class="bi bi-eye" aria-hidden="true"></i> {{ visible_label }}</span>
    <span data-toggle-password-target="hideLabel" hidden><i class="bi bi-eye-slash" aria-hidden="true"></i> {{ hidden_label }}</span>
</button>
